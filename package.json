  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@slack/bolt": "^5.1.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.7",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^17.4.2",
    "pdf-lib": "^1.17.1"
  },
